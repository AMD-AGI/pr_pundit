# GitHub Personal Access Token (required for scraping and PR diff fetching)
# Needs: repo, read:org scopes
GITHUB_TOKEN=ghp_your_token_here

# LiteLLM proxy — URL and master key for the inference gateway
# Run locally: https://docs.litellm.ai/docs/proxy/quick_start
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=your_litellm_master_key_here

# Microsoft Teams Incoming Webhook URL (optional — notifications skipped if unset)
TEAMS_WEBHOOK=https://your-org.webhook.office.com/webhookb2/...
